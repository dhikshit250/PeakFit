# PeakFit V2 — copy to `.env.local` for development (never commit secrets)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# PostgreSQL (new V2 database — not the legacy PeakFit DB)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/peakfit_v2?schema=public

# OpenRouter — model IDs are required when enabling AI (no hardcoded defaults in code)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_FALLBACK=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=PeakFit

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy migration only (Milestone 3+) — read-only; do not point Prisma at legacy for normal dev
# LEGACY_DATABASE_URL=