# PeakFit V2 — copy to `.env.local` for development (never commit secrets)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Playwright E2E (development Clerk user — never commit real passwords)
# Create a dedicated test user in Clerk Dashboard (password strategy).
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
# Optional: separate throwaway user for account-deletion E2E only (do not use the primary E2E user)
E2E_CLERK_DISPOSABLE_EMAIL=
E2E_CLERK_DISPOSABLE_PASSWORD=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# PostgreSQL — Aiven or other provider (V2 database only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/peakfit_v2?sslmode=require

# OpenRouter (https://openrouter.ai) — model IDs required before AI features work
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_FALLBACK=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=PeakFit

# Optional: run `RUN_OPENROUTER_PROBE=1 npm test -- tests/lib/integrations/openrouter/connectivity.integration.test.ts`
# after loading this file into the environment (never commit real keys).

# ImageKit (https://imagekit.io/dashboard) — Developer Options → API keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Optional: expose URL endpoint to client uploads (same value as above)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Legacy migration only (Milestone 3+) — read-only
# LEGACY_DATABASE_URL=